# ---- Production template (Render + Neon + Brevo) ----
# On Render, enter these in the dashboard (Environment). Never commit a real .env.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DEPLOYMENT_ENV=production
DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require
INCIDENT_UPLOAD_FOLDER=/tmp/incident_uploads
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
RATE_LIMIT_STORAGE_URI=memory://
RESET_BASE_URL=https://your-service-name.onrender.com
TRUST_PROXY_HOPS=1
WEB_CONCURRENCY=1

# Password-reset email via Brevo's HTTPS API (Render free blocks SMTP ports).
# Brevo -> SMTP & API -> API keys -> Restricted, Transactional email = All.
BREVO_API_KEY=replace-with-your-brevo-api-key
MAIL_DEFAULT_SENDER=your-verified-brevo-sender@example.com

# Optional SMTP alternative (paid hosts only). Not used while BREVO_API_KEY is set.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=replace-with-your-gmail-app-password
